import LeanAtlas.GraphData.Json

/-! Isolated adapter to the public Lean Atlas backend. It only reads the
certified environment; headline metadata is attached to exported nodes, never
registered on the project's declarations. -/
open Lean LeanAtlas.GraphData.Core

unsafe def main (args : List String) : IO Unit := do
  let out := args.headD "atlas.json"
  let heads ← IO.FS.readFile (args[1]!)
  let headline := heads.splitOn "\n"
  enableInitializersExecution
  initSearchPath (← findSysroot)
  let mods := (args.drop 2).toArray.map fun s => { module := s.toName : Import }
  let env ← importModules mods {} (trustLevel := 1024) (loadExts := true)
  IO.println "Lean Atlas: loaded compiled environment"
  let owns (n : Name) := (`Ehr).isPrefixOf n || (`CommitProtocol).isPrefixOf n || n == `Solution
  -- An unrestricted scope retains cross-namespace edges. Filter to the same
  -- project modules before constructing nodes, then drop external neighbors.
  let scope : LeanAtlas.Config.ProjectScope := { projectNamespace := .anonymous }
  let names := env.constants.toList.filterMap fun (n, _) => do
    let idx ← env.getModuleIdxFor? n
    if owns env.header.moduleNames[idx.toNat]! && LeanAtlas.Deps.Core.isRelevantConstant scope env n then some n else none
  let ownNames : NameSet := names.foldl (fun s n => s.insert n) {}
  let mut nodes : Array NodeData := #[]
  for n in names do
    let some ci := env.find? n | continue
    -- Atlas's recursive exprHasSorry revisits shared expression subtrees. Lean's
    -- collector checks the same direct constant occurrence once per DAG node.
    let hasPlaceholder := (ci.getUsedConstantsAsSet).contains ``sorryAx
    let kind := LeanAtlas.Deps.Core.classifyConstant env n
    let auto := isAutoGeneratedName n || isStructureFieldProjection env n
    let deps := (LeanAtlas.Deps.Core.getDirectDepsWithKind scope env n).filter (fun d => ownNames.contains d.name)
    let range := Lean.declRangeExt.find? env n
    let node : NodeData := {
      id := n, shortName := getShortName n, kind
      subKind := LeanAtlas.Deps.Core.classifyConstantDetailed env n auto
      filePath := ((LeanAtlas.Config.getModuleFor? env n).map moduleToFilePath).getD "unknown"
      hasSorry := hasPlaceholder
      progressMeta := buildNodeMeta env n hasPlaceholder kind
      dependencies := deps.map (·.name)
      dependenciesWithKind := deps.map (fun d => { name := d.name, kind := depKindToString d.kind })
      lineStart := range.map (·.selectionRange.pos.line)
      lineEnd := range.map (·.range.endPos.line)
      nonCommentLines := none
      isAutoGenerated := auto }
    let node := if let some entry := headline.find? (fun line => (line.splitOn "\t").headD "" == n.toString) then
      -- Reuse the ordinary extractor's checked axiom lists rather than repeat
      -- Atlas's uncached traversal for every headline.
      let hidden := ((entry.splitOn "\t").drop 1).headD "" |>.splitOn "," |>.filter (· != "") |>.toArray.map String.toName
      { node with progressMeta := { node.progressMeta with isMainTheorem := true, axioms := some #[], axiomsHidden := some hidden } }
      else node
    nodes := nodes.push node
  nodes := nodes.qsort (·.id.toString < ·.id.toString)
  let edges := buildEdges nodes
  let graph : GraphData := {
    metadata := { generatedAt := "compiled checkout", leanVersion := Lean.versionString, projectName := "VGI Health" }
    statistics := computeStatistics nodes edges
    nodes, edges }
  IO.FS.writeFile out (LeanAtlas.GraphData.Json.toJsonString graph)
  IO.println s!"Lean Atlas: {nodes.size} nodes, {edges.size} edges → {out}"
