# No need to copy this file: `node infra/scripts/setup.mjs` (or `make setup`) writes the real .env (gitignored)
# with the values for your local Medplum. This file only documents the keys. Other lanes may
# add their own keys to .env; setup.mjs preserves them.

# --- Medplum (written by infra/scripts/setup.mjs; safe to re-run) ---
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_APP_URL=http://localhost:3000/
# Project "VGI Health"
MEDPLUM_PROJECT_ID=00000000-0000-0000-0000-000000000000
# ClientApplication "VGI Health App": client_credentials for scripts (load, deploy, agent);
# the id alone is used for PKCE login from the browser app.
MEDPLUM_CLIENT_ID=00000000-0000-0000-0000-000000000000
MEDPLUM_CLIENT_SECRET=<generated by Medplum>
# Same values with the VITE_ prefix so a Vite app can read them (no secret here).
VITE_MEDPLUM_BASE_URL=http://localhost:8103/
VITE_MEDPLUM_PROJECT_ID=00000000-0000-0000-0000-000000000000
VITE_MEDPLUM_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Shared password for the persona logins p1@, p2@, p3@, rn2@, p4@, p5@vgi-health.example
# (random on first run; set it before running setup.mjs to choose your own).
VGI_USER_PASSWORD=<generated>
# Persona Practitioner references (also findable by identifier
# https://vgi-health.example/fhir/sid/persona|P1 ... |P5, |RN2).
VGI_PRACTITIONER_P1=Practitioner/<id>
VGI_PRACTITIONER_P2=Practitioner/<id>
VGI_PRACTITIONER_P3=Practitioner/<id>
VGI_PRACTITIONER_RN2=Practitioner/<id>
VGI_PRACTITIONER_P4=Practitioner/<id>
VGI_PRACTITIONER_P5=Practitioner/<id>

# --- W4 Keycloak (node infra/keycloak/setup.mjs creates the private values) ---
KEYCLOAK_ADMIN_PASSWORD=<generated>
KEYCLOAK_PERSONA_PASSWORD=<generated>
# Public browser issuer; must equal the operator COMMIT_CONFIG oidc.issuer.
VITE_KEYCLOAK_ISSUER=http://localhost:8180/realms/vgi
# Vite server-side proxy target (not a browser token or credential).
COMMIT_INTERNAL_URL=http://127.0.0.1:8090
