{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:smoke": "playwright test dashboard.spec.ts",
    "mock-run": "pnpm --filter agent exec tsx ../app/scripts/generate-mock.ts",
    "screen-check": "node scripts/screen-check.mjs",
    "export-mock-pages": "node scripts/export-mock-pages.mjs"
  },
  "dependencies": {
    "@mantine/core": "^8.3.17",
    "@mantine/hooks": "^8.3.17",
    "@mantine/notifications": "^8.3.17",
    "@mantine/spotlight": "^8.3.17",
    "@medplum/core": "5.2.13",
    "@medplum/react": "5.2.13",
    "@medplum/react-hooks": "5.2.13",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "signature_pad": "^5.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "fast-check": "^4.6.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "^3.9.10",
