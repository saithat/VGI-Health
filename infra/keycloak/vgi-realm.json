{
  "realm": "vgi",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "rn"
      },
      {
        "name": "physician"
      },
      {
        "name": "np"
      },
      {
        "name": "surgeon"
      }
    ]
  },
  "clients": [
    {
      "clientId": "vgi-mar",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:4179/?workflow=mar",
        "http://127.0.0.1:5173/?workflow=mar",
        "http://localhost:5173/?workflow=mar",
        "http://localhost:4173/?workflow=mar"
      ],
      "webOrigins": [
        "http://127.0.0.1:4179",
        "http://127.0.0.1:5173",
        "http://localhost:5173",
        "http://localhost:4173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "commit-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "vgi-commit",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "persona",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "persona",
            "claim.name": "persona",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
