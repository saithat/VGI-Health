{
  "name": "@vgi/commit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "migrate": "node --experimental-strip-types src/manage.ts migrate",
    "import": "node --experimental-strip-types src/manage.ts import",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/unit.test.ts",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 test/*integration.test.ts",
    "smoke": "node --experimental-strip-types test/smoke.ts",
    "test:protocol": "node --experimental-strip-types --test --test-concurrency=1 test/protocol.integration.test.ts",
    "check:trace": "node --experimental-strip-types model/check-trace.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
