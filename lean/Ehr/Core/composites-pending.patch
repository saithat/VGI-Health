+import Ehr.Core.Load
+import Ehr.Examples.TinyTests
+
+local instance {ε α : Type} [DecidableEq ε] [DecidableEq α] : DecidableEq (Except ε α) := by
+  intro a b
+  cases a <;> cases b <;> simp <;> infer_instance
+
+namespace Ehr.Examples.Tiny.Composite
+open Ehr.Composite
+
+/-- A rooming vitals strip: ordinary field/panel semantics under a presentation
+wrapper. This template grants no new clinical or backend behavior. -/
+def vitalsStrip : ComponentDef := {
+  name := "vitals-strip"
+  params := ["element", "label", "info"]
+  body := [
+    { id := "row", kind := .group false false, label := "{{label}}" },
+    { id := "weight", parent? := some "row",
+      kind := .field "{{element}}" (.fixed 0) (.fromRecord "weightToday"),
+      label := "{{label}} (kg)", tag := "vitals:{{element}}" },
+    { id := "history", kind := .panel "{{info}}", label := "Recent vitals" }]
+}
+
+def useVitals : Component := {
+  id := "vitals"
+  kind := .use "vitals-strip" [("element", "weight"), ("label", "Weight"), ("info", "vitals")]
+  label := "Vitals"
+}
+
+def source : Program := { program with
+  componentDefs := [vitalsStrip]
+  screens := program.screens.map fun sc =>
+    if sc.id == "rooming" then { sc with components := sc.components.map fun c =>
+      if c.id == "weightField" then useVitals else c } else sc }
+
+def expanded : Program := { program with
+  screens := program.screens.map fun sc =>
+    if sc.id == "rooming" then { sc with components := sc.components.flatMap fun c =>
+      if c.id == "weightField" then [
+        { useVitals with kind := .group false false, tag := "composite:vitals-strip" },
+        { id := "vitals/row", kind := .group false false, parent? := some "vitals", label := "Weight" },
+        { id := "vitals/weight", parent? := some "vitals/row",
+          kind := .field "weight" (.fixed 0) (.fromRecord "weightToday"),
+          label := "Weight (kg)", tag := "vitals:weight" },
+        { id := "vitals/history", parent? := some "vitals", kind := .panel "vitals", label := "Recent vitals" }]
+      else [c] } else sc }
+
+def vitalsSpec : Spec := { spec with infos := spec.infos ++
+  [{ id := "vitals", label := "Vitals", version := "" }] }
+
+def initial : State := init vitalsSpec expanded facts user
+
+#guard source.expand.toOption == some expanded
+#guard expanded.expand.toOption == some expanded
+#guard expanded.inCatalog vitalsSpec
+#guard roundTrips source && roundTrips useVitals && roundTrips vitalsStrip
+-- Existing JSON without componentDefs still decodes to the empty default.
+#guard (decodeJson Program (Lean.Json.mkObj [
+  ("id", Lean.toJson program.id), ("version", Lean.toJson program.version),
+  ("owner", Lean.toJson program.owner), ("role", Lean.toJson program.role),
+  ("specVersion", Lean.toJson program.specVersion), ("start", Lean.toJson program.start),
+  ("screens", Lean.toJson program.screens), ("macros", Lean.toJson program.macros)]).compress).toOption == some program
+#guard (view vitalsSpec expanded facts user initial).items.any fun i =>
+  i.comp.id == "vitals/weight" && i.shown && i.pendingConfirm
+#guard (step vitalsSpec expanded facts user .human initial (.confirm "vitals/weight")).1.captured.any fun c =>
+  c.element == "weight" && c.confirmed
+
+/-- This source property has an actual expanded witness with an interactive,
+visible record-confirm weight field. It is not a claim of checker certification. -/
+example : source.Satisfies (fun p => p = expanded ∧ p.inCatalog vitalsSpec = true) := by
+  exact ⟨expanded, by cbv, rfl, by decide⟩
+
+#guard (substitute [("x", "{{y}}"), ("y", "wrong")] "{{x}}").toOption == some "{{y}}"
+#guard (substitute [("x", "Ω🩺")] "A{{x}}{{x}}Z").toOption == some "AΩ🩺Ω🩺Z"
+#guard (substitute [] "{{unknown}}").toOption.isNone
+#guard (substitute [] "{{unclosed").toOption.isNone
+#guard (substitute [] "stray}}").toOption.isNone
+#guard (substitute [("x", "x")] "{{x}}stray}}").toOption.isNone
+
+def singleton (c : Component) (defs : List ComponentDef := [vitalsStrip]) : Program :=
+  { program with componentDefs := defs, screens :=
+    [{ id := "rooming", title := "Rooming", workflow := "W1", components := [c] }] }
+
+#guard ((singleton { useVitals with kind := .use "missing" [] }).expand).toOption.isNone
+#guard ((singleton { useVitals with kind := .use "vitals-strip" [] }).expand).toOption.isNone
+#guard ((singleton { useVitals with kind := .use "vitals-strip" [("element", "weight"), ("element", "dose"), ("info", "vitals")] }).expand).toOption.isNone
+#guard ((singleton useVitals [vitalsStrip, vitalsStrip]).expand).toOption.isNone
+#guard ((singleton useVitals [{ vitalsStrip with params := ["element", "element"] }]).expand).toOption.isNone
+#guard ((singleton useVitals [{ vitalsStrip with body := [useVitals] }]).expand).toOption.isNone
+-- Unused bad definitions cannot smuggle nested uses through certification.
+#guard ((singleton { id := "banner", kind := .banner } [{ vitalsStrip with body := [useVitals] }]).expand).toOption.isNone
+#guard ((singleton useVitals [{ vitalsStrip with body := [{ id := "x", kind := .panel "{{missing}}" }] }]).expand).toOption.isNone
+#guard ((singleton useVitals [{ vitalsStrip with body :=
+  [{ id := "x", kind := .group false false, parent? := some "x" }] }]).expand).toOption.isNone
+#guard ((singleton useVitals [{ vitalsStrip with body :=
+  [{ id := "x", kind := .panel "vitals", parent? := some "missing" }] }]).expand).toOption.isNone
+#guard ((singleton useVitals [{ vitalsStrip with body :=
+  [{ id := "x", kind := .panel "vitals" }, { id := "x", kind := .panel "vitals" }] }]).expand).toOption.isNone
+#guard ((singleton useVitals [{ vitalsStrip with body :=
+  [{ id := "x", kind := .panel "vitals", copyOf? := some "missing" }] }]).expand).toOption.isNone
+#guard ({ (singleton useVitals) with screens :=
+  [{ id := "rooming", title := "Rooming", workflow := "W1", components :=
+    [useVitals, { id := "vitals/weight", kind := .panel "vitals" }] }] }.expand).toOption.isNone
+-- Every template string location is substituted; only local ids are prefixed.
+#guard (component [("p", "bound")] {
+  id := "{{p}}"
+  kind := .button (.goto "{{p}}")
+  label := "{{p}}"
+  parent? := some "{{p}}"
+  visibility := .unlessReceipt "{{p}}"
+  hotkey? := some "{{p}}"
+  tag := "{{p}}"
+  copyOf? := some "{{p}}" }).toOption == some {
+    id := "bound"
+    kind := .button (.goto "bound")
+    label := "bound"
+    parent? := some "bound"
+    visibility := .unlessReceipt "bound"
+    hotkey? := some "bound"
+    tag := "bound"
+    copyOf? := some "bound" }
+#guard (loadInit { spec := vitalsSpec, program := source, facts, user }).toOption == some initial
+#guard (loadView { spec := vitalsSpec, program := source, facts, user, state := initial }).toOption ==
+  some (view vitalsSpec expanded facts user initial)
+#guard (loadStep {
+  spec := vitalsSpec
+  program := source
+  facts := facts
+  user := user
+  state := initial
+  event := .confirm "vitals/weight" }).toOption.any fun r =>
+    r.state.captured.any fun c => c.element == "weight" && c.confirmed
+#guard (loadInit { spec, program := singleton { useVitals with kind := .use "missing" [] }, facts, user }).toOption.isNone
+#guard (instantiate [vitalsStrip] { useVitals with id := "second" }).toOption |>.any fun cs =>
+  cs.any (·.id == "second/weight")
+end Ehr.Examples.Tiny.Composite
