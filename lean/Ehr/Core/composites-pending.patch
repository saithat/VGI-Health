+import Ehr.Core.Expand
+import Ehr.Core.View
+
+/-! Checked source-program boundaries. Callers retain the source for hashes and
+certificates; every interpreter input below uses the expansion or returns error. -/
+namespace Ehr.Composite
+
+def loadInit (i : InitInput) : Except String State := do
+  let p ← i.program.expand
+  return Ehr.init i.spec p i.facts i.user
+
+def loadStep (i : StepInput) : Except String StepOutput := do
+  let p ← i.program.expand
+  let r := Ehr.step i.spec p i.facts i.user .human i.state i.event
+  return { state := r.1, result := r.2 }
+
+def loadView (i : ViewInput) : Except String ScreenView := do
+  let p ← i.program.expand
+  return Ehr.view i.spec p i.facts i.user i.state
+
+/-- An expansion failure belongs to wellFormed. It must be checked before any
+other property and before publishing; the source remains the hash input. -/
+def expansionVerdict (p : Program) : Verdict :=
+  match p.expand with
+  | .ok _ => .ok
+  | .error e => .violation "wellFormed" ("composite expansion: " ++ e) [] []
+
+/-- Source interpretation runs the exact existing interpreter on expansion. -/
+theorem loadStep_of_expanded (i : StepInput) (p : Program) (h : i.program.expand = .ok p) :
+    loadStep i = .ok (let r := Ehr.step i.spec p i.facts i.user .human i.state i.event
+      { state := r.1, result := r.2 }) := by
+  simp [loadStep, h, bind, pure, Except.bind, Except.pure]
+
+/-- Invalid source programs cannot execute a step. -/
+theorem loadStep_of_error (i : StepInput) (e : String) (h : i.program.expand = .error e) :
+    loadStep i = .error e := by
+  simp [loadStep, h, bind, Except.bind]
+
+#print axioms loadStep_of_expanded
+#print axioms loadStep_of_error
+end Ehr.Composite
