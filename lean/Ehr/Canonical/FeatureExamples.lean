/-- Actual six-calendar-month anniversary, October 31 to April 30. -/
def sixMonthCutoff : ClockStamp := { time := 30151730, year := 2027, month := 4, day := 30, minuteOfDay := 1010, utcOffsetMinutes := 0, zone := "UTC" }

/-- Independent durable orders, not UI-slot clocks. -/
def clocks (f : Facts) : List OrderClock :=
  [{ id := "fixture.detention", patient := f.patientId, issued, started? := some issued, firstFill? := some issued, monthCutoffs := [{ anchor := .issued, months := 6, stamp := sixMonthCutoff }] }, { id := "fixture.emergencyScheduleIIRx", patient := f.patientId, issued, started? := some issued, firstFill? := some issued, monthCutoffs := [{ anchor := .issued, months := 6, stamp := sixMonthCutoff }] }, { id := "fixture.newbornOxygen", patient := f.patientId, issued, started? := some issued, firstFill? := some issued, monthCutoffs := [{ anchor := .issued, months := 6, stamp := sixMonthCutoff }] }, { id := "fixture.scheduleIIItoVRx", patient := f.patientId, issued, started? := some issued, firstFill? := some issued, monthCutoffs := [{ anchor := .issued, months := 6, stamp := sixMonthCutoff }] }, { id := "fixture.scheduleIIRx", patient := f.patientId, issued, started? := some issued, firstFill? := some issued, monthCutoffs := [{ anchor := .issued, months := 6, stamp := sixMonthCutoff }] }, { id := "fixture.violentRestraint", patient := f.patientId, issued, started? := some issued, firstFill? := some issued, monthCutoffs := [{ anchor := .issued, months := 6, stamp := sixMonthCutoff }] }]

