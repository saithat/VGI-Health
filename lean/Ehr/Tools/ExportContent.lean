import Ehr.Canonical.Urgency
import Ehr.Core.Json
import Ehr.Canonical.Personas
import Ehr.Canonical.BadPrograms

/-! Reproducible, pretty JSON exports from Lean-owned content. Run from lean/:
`lake exe export-content [repo-root]` (default `..`). Generated files are never
hand edited. This executable exports data, not certification verdicts. -/
namespace Ehr.Tools.ExportContent
open Ehr Ehr.Canonical

/-- Write JSON and create its destination directory. -/
def writeJson [Lean.ToJson α] [Lean.FromJson α] [BEq α] (root : System.FilePath) (path : String) (x : α) : IO Unit := do
  match Lean.fromJson? (Lean.toJson x) with
  | .error e => throw (IO.userError s!"{path}: JSON decode failed: {e}")
  | .ok y => if y != x then throw (IO.userError s!"{path}: JSON round-trip changed content")
  let dest := root / path
  if let some parent := dest.parent then IO.FS.createDirAll parent
  IO.FS.writeFile dest ((Lean.toJson x).pretty ++ "\n")

/-- Number of components matching a predicate. -/
def count (p : Program) (f : Component → Bool) : Nat := (components p).filter f |>.length

/-- Canonical v1 scale and prompt accounting; generated alongside the JSON.
Prompts are field instances, including repeated optional prompts and fixed rows. -/
def stats : String :=
  let p := canonicalV1
  let sp := Specs.V1.specV1
  let fields := (components p).filter fun c => match c.kind with | .field .. => true | _ => false
  let prompts := fun friction => fields.filter (fun c => match c.kind with
    | .field e _ _ => (sp.element? e).any (·.friction == friction) | _ => false) |>.length
  let actions := count p fun c => match c.kind with | .button .. | .«macro» .. => true | _ => false
  let alertRows := [Tier.interruptive, .passive, .removable].map fun tier =>
    let name := match tier with | .interruptive => "Interruptive" | .passive => "Passive" | .removable => "Removable"
    let rules := (sp.alerts.filter (·.tier == tier)).length
    let instances := count p fun c => match c.kind with
      | .alert a _ => (sp.alert? a).any (·.tier == tier) | _ => false
    s!"| {name} | {rules} | {instances} |"
  "# Canonical v1 statistics\n\nGenerated by `cd lean && lake exe export-content`.\n\n" ++
  "| Measure | BRIEF target | Actual |\n|---|---:|---:|\n" ++
  s!"| Screens | 25–30 (approximate) | {p.screens.length} |\n" ++
  s!"| Field prompts | 150+ | {fields.length} |\n" ++
  s!"| Actions (buttons and macro buttons) | 100+ | {actions} |\n" ++
  s!"| Alert types | 12+ | {sp.alerts.length} |\n" ++
  s!"| All components | — | {(components p).length} |\n| Macros | — | {p.macros.length} |\n" ++
  s!"| Spec elements | — | {sp.elements.length} |\n| Spec infos | — | {sp.infos.length} |\n| Commits | — | {sp.commits.length} |\n\n" ++
  "The screen count exceeds the approximate target because verification, results messages, consult close, and surgical steps remain separate. All W1–W7 paths are retained.\n\n" ++
  "| Alert tier | Spec rules | UI instances |\n|---|---:|---:|\n" ++ "\n".intercalate alertRows ++ "\n\n" ++
  "| Prompt friction | Field instances |\n|---|---:|\n" ++
  s!"| Safety | {prompts Friction.safety} |\n| Compliance | {prompts Friction.compliance} |\n| Accidental | {prompts Friction.accidental} |\n\n" ++
  "Counts include hidden tabs/groups, composer and fixed-slot order-set rows, and the shared Home shell. Repeated bindings in different workflows are counted as separate prompts. Alert instances differ from alert rules because multiple workflows use the same rule. A button is an action instance, not a count of all possible data-entry events.\n"

/-- Export every release and seed in one reproducible invocation. -/
def exportAll (root : System.FilePath) : IO Unit := do
  writeJson root "programs/canonical/v1.json" canonicalV1
  writeJson root "lean/Ehr/Check/bad-program-profiles.json"
    (Bad.corePrograms.map (·.1) |>.zip Bad.coreExpectedProperties, Bad.fullProfileOnly)
  for (v, sp, p) in Urgency.releases do
    writeJson root s!"releases/{v}/spec.json" sp
    writeJson root s!"releases/{v}/canonical.json" p
    for (persona, role) in personaRoles do
      writeJson root s!"releases/{v}/personas/{persona}.json" (forPersona sp p persona role)
  let bad := if Specs.ruleProfile == .full then Bad.programs else Bad.corePrograms
  for (name, p) in bad do writeJson root s!"programs/bad/{name}.json" p
  IO.FS.writeFile (root / "programs/canonical/STATS.md") stats
  IO.println "Exported canonical v1, v2, v3; 15 persona canonicals; active bad programs; specs; statistics."
end Ehr.Tools.ExportContent

/-- Repository root defaults to the parent of the lean directory. -/
def main (args : List String) : IO Unit := do
  if args.length > 1 then throw (IO.userError "usage: export-content [repo-root]")
  Ehr.Tools.ExportContent.exportAll (args.headD "..")
